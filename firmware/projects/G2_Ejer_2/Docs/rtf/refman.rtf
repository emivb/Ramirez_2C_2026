00201 \par
00202 {\cf20 /*==================[external functions definition]==========================*/}\par
00206 {\cf18 void} app_main({\cf18 void})\par
00207 \{\par
00208     {\cf20 /* Inicializaci\'F3n de perif\'E9ricos y sensores */}\par
