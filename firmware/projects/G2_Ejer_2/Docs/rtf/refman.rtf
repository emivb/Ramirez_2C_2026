00137     {\cf19 else} {\cf19 if} (dis >= 30)\par
00138     \{\par
00139         LedOn(LED_1);\par
00140         LedOn(LED_2);\par
00141         LedOn(LED_3);\par
00142     \}\par
00143     {\cf19 else}\par
00144     \{\par
00145         LedsOffAll();\par
00146     \}\par
00147 \}\par
00148 \par
00149 {\cf18 void} toggle({\cf18 bool} *al)\par
00150 \{\par
00151     {\cf19 if} (al != NULL)\par
00152     \{\par
00153         *al = !(*al);\par
00154     \}\par
00155 \}\par
00156 \par
00157 {\cf18 void} Tecla1({\cf18 void} *pvParameter)\par
00158 \{\par
00159     toggle(&prender);\par
00160 \}\par
00161 \par
00162 {\cf18 void} Tecla2({\cf18 void} *pvParameter)\par
00163 \{\par
00164     toggle(&mantener);\par
00165 \}\par
00166 \par
00167 {\cf17 static} {\cf18 void} Mostrar_task({\cf18 void} *pvParameter)\par
00168 \{\par
00169     {\cf19 while}({\cf17 true})\par
00170     \{\par
00171         {\cf19 if} (prender)\par
00172         \{\par
00173             Leds(distancia);\par
00174             {\cf19 if} (!mantener)\par
00175             \{\par
00176                 LcdItsE0803Write(distancia);\par
00177             \}\par
00178         \}\par
00179         {\cf19 else}\par
00180         \{\par
00181             apagartodo();\par
00182         \}\par
00183         \par
00184         vTaskDelay(mostrar_delay / portTICK_PERIOD_MS);\par
00185     \}\par
00186 \}\par
00187 \par
00188 {\cf17 static} {\cf18 void} Medir_task({\cf18 void} *pvParameter)\par
