00129 {\cf18 void} Leds(uint16_t dis)\par
00130 \{\par
00131     {\cf19 if} (dis>=10 && distancia <20)\par
00132     \{\par
00133         LedOn(LED_1);\par
00134         LedOff(LED_2);\par
00135         LedOff(LED_3);\par
00136         \par
00137     \}\par
00138     {\cf19 if} (dis >=20 && distancia <30)\par
00139     \{\par
00140         LedOn(LED_1);\par
00141         LedOn(LED_2);\par
00142         LedOff(LED_3);\par
00143 \par
00144     \}\par
00145     {\cf19 if}(dis>=30)\par
00146     \{\par
00147         LedOn(LED_1);\par
00148         LedOn(LED_2);\par
00149         LedOn(LED_3);\par
00150     \}\par
00151     {\cf19 if}(dis<10)\par
00152     \{\par
00153         LedsOffAll();\par
00154     \}\par
00155     \par
00156 \}\par
00157 \par
00158 {\cf18 void} toggle({\cf18 bool} *al)\par
00159 \{\par
00160     *al = !(*al);\par
00161 \}\par
00162 \par
00163 {\cf18 void} Funcomunicacion({\cf18 void}* param)\{\par
00164     uint8_t caracter;\par
00165     UartReadByte(UART_PC, &caracter);              {\cf20 // ac\'E1 se busca el dato que avis\'F3 la interrupci\'F3n}\par
00166     {\cf19 if} (caracter == {\cf23 'O'} || caracter == {\cf23 'o'})\par
00167     \{\par
00168         toggle(&prender);\par
00169         UartSendString(UART_PC, {\cf22 "Se apreto la o"});  {\cf20 // base 10 -> "1024"}\par
00170         UartSendString(UART_PC, {\cf22 "\\r\\n"});\par
00171 \par
00172     \}\par
00173     {\cf19 if} (caracter == {\cf23 'H'} || caracter == {\cf23 'h'})\par
00174     \{\par
00175         toggle(&mantener);\par
00176         UartSendString(UART_PC, {\cf22 "Se apreto la H"});  {\cf20 // base 10 -> "1024"}\par
00177         UartSendString(UART_PC, {\cf22 "\\r\\n"});\par
00178     \}\par
00179 \}\par
00180 \par
00181 {\cf17 static} {\cf18 void} Mostrar_task({\cf18 void} *pvParameter)\{\par
00182     {\cf19 while}({\cf17 true})\{\par
00183         {\cf19 if} (prender)\par
00184         \{\par
00185             Leds(distancia);\par
00186             {\cf19 if} (mantener== {\cf17 false})\par
00187             \{\par
00188               LcdItsE0803Write(distancia);\par
00189             \}\par
00190 \par
00191             \par
00192         \}\par
00193         {\cf19 else}\par
00194         \{\par
00195             apagartodo();\par
00196         \}\par
00197         \par
00198         vTaskDelay(mostrar_delay / portTICK_PERIOD_MS);\par
00199     \}\par
00200 \}\par
00201 \par
00202 {\cf18 void} Tecla1({\cf18 void} *pvParameter)\{\par
00203     toggle(&prender);\par
00204 \}\par
00205 \par
00206 {\cf18 void} Tecla2({\cf18 void} *pvParameter)\{\par
00207     toggle(&mantener);\par
00208 \}\par
00209 \par
00210 {\cf17 static} {\cf18 void} Medir_task({\cf18 void} *pvParameter)\{\par
00211     {\cf19 while}({\cf17 true})\{\par
00212         {\cf19 if} (prender)\par
00213         \{\par
00214             distancia = HcSr04ReadDistanceInCentimeters();\par
00215         \}\par
00216         {\cf19 if}(mantener == {\cf17 false})\par
00217         \{\par
00218             aux = distancia;\par
00219         \}\par
00220         \par
00221         UartSendString(UART_PC, ({\cf18 char} *) UartItoa(aux, 10));  \par
00222         UartSendString(UART_PC, {\cf22 " cm"});\par
00223         UartSendString(UART_PC, {\cf22 "\\r\\n"});\par
00224         \par
00225         vTaskDelay(medir_delay / portTICK_PERIOD_MS);\par
00226     \}\par
00227 \}\par
